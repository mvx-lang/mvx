# syntax=docker/dockerfile:1
# MVX base image — the compiler, shell, runtime, drivers, and the
# standard verbs, installed to /usr/local so `mvx` runs from PATH.
#
#   docker build -f docker/Dockerfile.base -t mvx .
#   docker run --rm -it mvx                 # MVX shell in a scratch account
#   docker run --rm -it mvx mvx-basic -h    # or run any tool directly
#
# SPDX-License-Identifier: GPL-2.0-only

# ---- builder: compile MVX and install to a clean /usr/local -----------
ARG LLVM_VERSION=21
FROM debian:bookworm-slim AS builder
ARG LLVM_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates wget gnupg lsb-release software-properties-common \
      cmake ninja-build gcc g++ \
      liblmdb-dev libedit-dev libpq-dev

# apt.llvm.org, WITH RETRIES.  LLVM 21 is in neither Debian nor Ubuntu, so this
# host is the only source and the image cannot avoid depending on it — but it
# does not have to depend on it being up at one instant.  The v0.1.3 release
# failed exactly here, on llvm.sh's own key check, and passed on re-run
# (mvx#141).  Retry the fetch, the script AND the install together: the script
# adds the repository and the install pulls from it, so either can be the one
# that cannot reach the host.
#
# This runs ONCE PER ARCHITECTURE, not three times as the issue supposed: the
# daemon and demo images build FROM this one and install no LLVM of their own.
ARG LLVM_VERSION
RUN set -eu; ok=; \
    for attempt in 1 2 3 4 5; do \
      if wget -qO /tmp/llvm.sh https://apt.llvm.org/llvm.sh \
         && chmod +x /tmp/llvm.sh \
         && /tmp/llvm.sh ${LLVM_VERSION} \
         && apt-get install -y --no-install-recommends llvm-${LLVM_VERSION}-dev; then \
        ok=1; break; \
      fi; \
      echo "apt.llvm.org attempt ${attempt} failed; retrying in $((attempt * 15))s"; \
      sleep $((attempt * 15)); \
    done; \
    if [ -z "$ok" ]; then \
      echo "apt.llvm.org unreachable after 5 attempts over ~4 minutes." >&2; \
      echo "Nothing is wrong with the code; rebuild when the host is back." >&2; \
      exit 1; \
    fi; \
    rm -rf /var/lib/apt/lists/*

# LLVM's exported CMake targets reference these compression / terminfo
# libraries; their -dev packages must be present for find_package(LLVM).
RUN apt-get update && apt-get install -y --no-install-recommends \
      zlib1g-dev libzstd-dev libncurses-dev \
 && rm -rf /var/lib/apt/lists/*

# The version to stamp into the binaries.  .dockerignore excludes .git, so a
# build here cannot ask git what it is and every image reported 0.0.0-dev until
# this was passed in (mvx#299).  Empty falls back to that same answer.
ARG MVX_VERSION=""

COPY . /src
WORKDIR /src
# The install lists each package's releases through the GitHub API (mvx#212),
# which is rate-limited per IP -- and a limited listing does not fail the
# build, it quietly leaves the packages out of the image.  So a token is used
# when the build is given one, as a BuildKit SECRET: a build-arg would stay in
# the image history.  Without one (a local `docker build') it runs as before.
# Nobody answers a prompt in a build, so the install takes each package's
# latest stable release.
RUN --mount=type=secret,id=github_token \
    if [ -s /run/secrets/github_token ]; then \
      GITHUB_TOKEN="$(cat /run/secrets/github_token)"; export GITHUB_TOKEN; \
    fi; \
    cmake -S . -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DMVX_VERSION="${MVX_VERSION}" \
      -DCMAKE_PREFIX_PATH=/usr/lib/llvm-${LLVM_VERSION} \
 && cmake --build build \
 && MVX_INSTALL_PROMPT=never cmake --install build --prefix /usr/local

# ---- runtime: the install plus a C toolchain to compile BASIC ---------
FROM debian:bookworm-slim AS mvx
# gcc + libc6-dev provide `cc` and the C runtime objects / link stubs
# (crt*.o, libm.so, libdl.so) that mvx-basic needs to link programs; the
# rest are the runtime's shared-library dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
      gcc libc6-dev libstdc++6 liblmdb0 libedit2 libpq5 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local/bin   /usr/local/bin
COPY --from=builder /usr/local/lib   /usr/local/lib
COPY --from=builder /usr/local/share /usr/local/share
RUN echo /usr/local/lib > /etc/ld.so.conf.d/mvx.conf && ldconfig

# Developer tier so BASIC / CATALOG / COMPILE() work out of the box.
ENV MVXPRIV=developer
# A scratch account to log on to by default.
RUN mkdir -p /work \
 && mvx -a /work -c "CREATE-FILE VOC" \
 && printf '# MVX account descriptor\nname = work\nversion = 1\n' > /work/.mvx
WORKDIR /work
CMD ["mvx", "-a", "/work"]
