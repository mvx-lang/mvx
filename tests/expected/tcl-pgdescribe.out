postgres: SELECT id FROM "mvxtest"."MWP" WHERE "STATE" = 'NSW'
postgres: SELECT id FROM "mvxtest"."MWP" WHERE "STATE" = 'NSW' AND EXISTS (SELECT 1 FROM jsonb_array_elements_text(CASE WHEN jsonb_typeof(doc->'2') = 'array' THEN doc->'2' ELSE jsonb_build_array(COALESCE(doc->>'2','')) END) mv WHERE mv ~ '^-?[0-9]+(\.[0-9]+)?$' AND mv::numeric > '500'::numeric)
postgres: SELECT id FROM "mvxtest"."MWP" ORDER BY "PRICE" LIMIT 3
postgres: SELECT id FROM "mvxtest"."MWP"; 1 condition(s) applied in the verb
