#
# Install the MVX system account.  The standard verbs are (re)cataloged
# with the just-installed compiler, so each verb executable's runtime
# rpath points at the install's own lib directory rather than the build
# tree.  The master VOC and its dictionary are copied alongside.
# POLICIES ARE SET HERE, not inherited -- the same trap pkgver.cmake documents.
# This runs inside `cmake --install', where no project has set any, so an older
# CMake applies the OLD behaviour of every policy: under that, if(IN_LIST) is
# an unknown argument.  It passed on a Mac and failed on Ubuntu's 3.28 once
# already (mvx#212), and this script grew its first IN_LIST with mvx#218.
# PUSH/POP leaves the calling cmake_install.cmake as it was.
cmake_policy(PUSH)
cmake_policy(VERSION 3.24)

set(SRC "@MVX_SOURCE_DIR@")
set(BIN "@MVX_BINARY_DIR@")
set(SYS "${CMAKE_INSTALL_PREFIX}/share/mvx/system")
set(MVXBASIC "${CMAKE_INSTALL_PREFIX}/bin/mvx-basic")

file(MAKE_DIRECTORY "${SYS}/CATALOG")
file(REMOVE_RECURSE "${SYS}/VOC" "${SYS}/VOC.DICT")
file(COPY "${SRC}/system/VOC"      DESTINATION "${SYS}")
file(COPY "${SRC}/system/VOC.DICT" DESTINATION "${SYS}")

# THE DESCRIPTOR SHIPS TOO.  The build target copies system/.mvx into the build
# tree and this script did not copy it into the install, so a published
# toolchain's system account was VOC + VOC.DICT + CATALOG and nothing else.
# mkaccount.sh seeds every new account's permit/deny baseline from it, so
# without it an account made from an installed toolchain has no OS-command
# policy at all (mvx#137).  A dotfile is easy to miss in a copy list; naming it
# explicitly is the point.
file(COPY "${SRC}/system/.mvx" DESTINATION "${SYS}")

# The packages built into the system account (MVX_PACKAGES: json, http) live in
# the BUILD tree, not the source -- EXPORTS names their functions and LIB holds
# them.  Without these an installed toolchain resolves none of the system
# package functions a program may call.
foreach(part EXPORTS EXPORTS.d LIB)
  if(EXISTS "${BIN}/system/${part}")
    file(COPY "${BIN}/system/${part}" DESTINATION "${SYS}")
  endif()
endforeach()

file(GLOB verbs "${SRC}/verbs/*.b")
foreach(v ${verbs})
  get_filename_component(vn "${v}" NAME_WE)
  execute_process(
    COMMAND "${MVXBASIC}" "${v}" -o "${SYS}/CATALOG/${vn}"
    RESULT_VARIABLE rc)
  if(rc)
    message(FATAL_ERROR "mvx: cataloging ${vn} failed (${rc})")
  endif()
  message(STATUS "  cataloged ${vn}")
endforeach()
# --- published packages, downloaded prebuilt (mvx#198) ----------------------
#
# An installed mvx used to have no GIT.  The package submodules went away in
# #169 and nothing replaced them for a USER: the tests fetch packages, the
# install did not.  So the install now does what a person would otherwise do by
# hand -- fetch the published package for this platform and put it in the system
# account, where every account sees it with no LINK-PKG.
#
# MVPKG COMES FIRST AND ALWAYS.  It is how anything else gets installed later;
# shipping a toolchain that cannot install a package, and telling people to
# install a package to get it, is a circle.
set(MVX_PKG_TRIPLE "@MVX_PKG_OS@-@MVX_PKG_ARCH@-@MVX_PKG_ENDIAN@")

# Where a bundled package's asset comes from.  Overridable so the suite can
# serve a file:// tree instead of GitHub: the download, the checksum, the
# native-library check, the EXPORTS merge and the dependency walk are then all
# exercised without a network (mvx#218).  The same reason pkgver.cmake takes
# MVX_INSTALL_RELEASES.
set(MVX_PKG_BASEURL "$ENV{MVX_INSTALL_PKGBASE}")
if(MVX_PKG_BASEURL STREQUAL "")
  set(MVX_PKG_BASEURL "https://github.com/mvx-lang")
endif()

# What has been installed already, so a dependency shared by two packages is
# fetched once.  A GLOBAL property rather than a variable: this is written
# inside nested function calls, and PARENT_SCOPE only reaches one level.
set_property(GLOBAL PROPERTY MVX_INSTALLED_PACKAGES "")

function(_mvx_mark_installed name)
  get_property(done GLOBAL PROPERTY MVX_INSTALLED_PACKAGES)
  list(APPEND done "${name}")
  set_property(GLOBAL PROPERTY MVX_INSTALLED_PACKAGES "${done}")
endfunction()

function(_mvx_is_installed name out)
  get_property(done GLOBAL PROPERTY MVX_INSTALLED_PACKAGES)
  if(name IN_LIST done)
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

# A package's own dependencies, and whether its native libraries load here.
include("${CMAKE_CURRENT_LIST_DIR}/pkgdeps.cmake")

# mvx_merge_exports(<key> <exports-file>)
#
# EXPORTS is what the compiler reads to know an extension function exists, and
# it is an aggregate of every installed package's -- so nothing in it says WHICH
# package a name came from.  That mattered as soon as two packages exported the
# same name: `http' and `curl' both provide HTTPGET, and which one answered was
# directory-read order, which is not an order (#218).
#
# So the parts are kept beside the aggregate, one file per package under
# EXPORTS.d/, and the aggregate is rebuilt from them.  A package being installed
# WINS every name it exports, and any package whose names it wholly covers is
# superseded -- its entry and its extension library go, because leaving a second
# library exporting the same names is the ambiguity this exists to remove.
# `http' is exactly that case: its names are a subset of curl's.
function(mvx_merge_exports key file)
  if(NOT EXISTS "${file}")
    return()
  endif()
  set(dir "${SYS}/EXPORTS.d")
  file(MAKE_DIRECTORY "${dir}")
  _mvx_exports_names("${file}" mine)
  if(mine STREQUAL "")
    return()
  endif()
  file(GLOB others "${dir}/*")
  foreach(o ${others})
    get_filename_component(okey "${o}" NAME)
    if(okey STREQUAL key)
      continue()
    endif()
    _mvx_exports_names("${o}" theirs)
    if(theirs STREQUAL "")
      continue()
    endif()
    set(covered TRUE)
    foreach(n ${theirs})
      if(NOT n IN_LIST mine)
        set(covered FALSE)
      endif()
    endforeach()
    if(covered)
      file(REMOVE "${o}")
      foreach(lib "${SYS}/LIB/libmvxext_${okey}.so" "${SYS}/LIB/libmvxext_${okey}.dylib")
        if(EXISTS "${lib}")
          file(REMOVE "${lib}")
        endif()
      endforeach()
      message(STATUS "  ${key} supersedes ${okey} (${theirs})")
    endif()
  endforeach()

  file(COPY "${file}" DESTINATION "${dir}")
  get_filename_component(fn "${file}" NAME)
  if(NOT fn STREQUAL key)
    file(RENAME "${dir}/${fn}" "${dir}/${key}")
  endif()

  # Rebuild the aggregate: this package first, so a name it shares with one
  # that was NOT superseded still resolves to it.
  set(lines "")
  set(seen "")
  foreach(f "${dir}/${key}" ${others})
    if(NOT EXISTS "${f}")
      continue()
    endif()
    file(STRINGS "${f}" fl)
    foreach(l ${fl})
      string(REGEX MATCH "^[ \t]*([^ \t#*][^ \t]*)" m "${l}")
      set(n "${CMAKE_MATCH_1}")
      if(NOT n STREQUAL "" AND NOT n IN_LIST seen)
        list(APPEND seen "${n}")
        list(APPEND lines "${l}")
      endif()
    endforeach()
  endforeach()
  string(REPLACE ";" "\n" body "${lines}")
  file(WRITE "${SYS}/EXPORTS" "${body}\n")
endfunction()

# _mvx_exports_names(<file> <out>) — the names an EXPORTS file declares
function(_mvx_exports_names file out)
  set(names "")
  if(EXISTS "${file}")
    file(STRINGS "${file}" fl)
    foreach(l ${fl})
      string(REGEX MATCH "^[ \t]*([^ \t#*][^ \t]*)" m "${l}")
      if(NOT CMAKE_MATCH_1 STREQUAL "")
        list(APPEND names "${CMAKE_MATCH_1}")
      endif()
    endforeach()
  endif()
  set(${out} "${names}" PARENT_SCOPE)
endfunction()

# mvx_install_tree(<display> <dir>) — put an unpacked package into the system
# account: the account parts, any CLI, and its EXPORTS.
function(mvx_install_tree name dir)
  foreach(part CATALOG VOC VOC.DICT LIB CMD.BP CMD.BP.DICT BP)
    if(EXISTS "${dir}/${part}")
      file(COPY "${dir}/${part}" DESTINATION "${SYS}")
    endif()
  endforeach()
  if(EXISTS "${dir}/EXPORTS")
    mvx_merge_exports("${name}" "${dir}/EXPORTS")
  endif()
  if(EXISTS "${dir}/bin")
    file(GLOB clis "${dir}/bin/*")
    foreach(c ${clis})
      file(COPY "${c}" DESTINATION "${CMAKE_INSTALL_PREFIX}/bin"
           FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
                            GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    endforeach()
  endif()
endfunction()

# mvx_install_deps(<manifest> <depth>)
#
# What the package just installed says it needs (#218).  Required dependencies
# only, and only those that apply to mvx: an optional one is optional, and
# `json@!mvx' is built into the runtime here.  Each is resolved through the
# REGISTRY -- which is what knows that `curl' on mvx/linux/x86_64 is
# mvx-lang/curl 1.4.0 and where its tarball is -- and installed the same way as
# a bundled package, recursively.
#
# NOTHING IS ASKED.  #212 asks which version of a package a person wants; a
# dependency is not a choice they made, it is what the package they chose needs.
function(mvx_install_deps manifest depth)
  if(depth GREATER 4)
    message(WARNING "mvx: dependency chain deeper than 4, stopping")
    return()
  endif()
  mvx_dep_list("${manifest}" mvx deps)
  foreach(d ${deps})
    string(REPLACE "|" ";" parts "${d}")
    list(GET parts 0 dname)
    set(dcons "")
    list(LENGTH parts np)
    if(np GREATER 1)
      list(GET parts 1 dcons)
    endif()
    string(REGEX REPLACE "^.*/" "" dkey "${dname}")
    _mvx_is_installed("${dkey}" already)
    if(already)
      continue()
    endif()
    mvx_registry_resolve("${dname}" "${MVX_PKG_TRIPLE}" mvx "${BIN}/pkgdl" js)
    if(js STREQUAL "")
      message(WARNING
        "mvx: ${dname} is required by this package and the registry could not\n"
        "     resolve it for ${MVX_PKG_TRIPLE}.  Install it later with mvpkg.")
      continue()
    endif()
    mvx_json_field("${js}" version dver)
    mvx_json_field("${js}" tarball dtar)
    mvx_json_field("${js}" name dfull)
    if(NOT dcons STREQUAL "")
      mvx_ver_satisfies("${dver}" "${dcons}" ok)
      if(NOT ok)
        mvx_json_field("${js}" versions dvers)
        mvx_pick_version("${dvers}" "${dcons}" want)
        if(want STREQUAL "")
          message(WARNING
            "mvx: no release of ${dname} satisfies ${dcons} -- skipping it.")
          continue()
        endif()
        mvx_registry_resolve("${dname}" "${MVX_PKG_TRIPLE}" mvx "${BIN}/pkgdl" js "${want}")
        if(js STREQUAL "")
          message(WARNING "mvx: ${dname} ${want} could not be resolved -- skipping it.")
          continue()
        endif()
        mvx_json_field("${js}" version dver)
        mvx_json_field("${js}" tarball dtar)
      endif()
    endif()
    if(dtar STREQUAL "")
      message(WARNING "mvx: ${dname} has no published build for ${MVX_PKG_TRIPLE} -- skipping it.")
      continue()
    endif()
    string(REGEX REPLACE "^.*/" "" dshort "${dfull}")
    message(STATUS "  ${dshort} ${dver} is required here")
    mvx_install_url("${dshort}" "${dver}" "${dtar}" ${depth})
  endforeach()
endfunction()

# mvx_source_build(<display> <version> <source-url> <workdir> <outvar>)
#
# Build the package HERE, from its published source, and return the directory
# holding the result (empty when it could not be done).
#
# WHY THIS EXISTS (mvx#370).  A prebuilt native library is linked against one
# libgit2 soname, and libgit2 bumps its soname at every minor -- its own
# api-stability document says symbol names, signatures and struct layout are
# "only stable within minor releases".  So a binary built against 1.7 cannot
# load on a host carrying 1.9, and there is no version of "install the right
# library" that a user can act on: Ubuntu 25.10 and 26.04 publish 1.9 and no
# 1.7 at all.  Building here links against whatever this machine actually has.
#
# A FALLBACK, NOT THE DEFAULT.  Where the prebuilt loads it is still what gets
# installed, so no host acquires a compiler requirement it did not have before
# and the common path does not slow down.
function(mvx_source_build name version srcurl workdir outvar)
  set(${outvar} "" PARENT_SCOPE)
  if(srcurl STREQUAL "")
    return()
  endif()
  # mkpkg IS NOT SHIPPED (mvx#369), so this path exists only where mvx was
  # built from source -- which is exactly where it is needed and where the
  # script is certain to be present.  An installed toolchain reaches the same
  # package through `MVPKG install', and making THAT build from source is a
  # different job with its own blocker.
  set(mkpkg "${SRC}/scripts/mkpkg.sh")
  if(NOT EXISTS "${mkpkg}")
    return()
  endif()
  # Named here rather than left to the compiler to miss: build-native.sh calls
  # `cc' and asks pkg-config for the library's flags.
  find_program(MVX_PKG_CC NAMES cc gcc clang)
  if(NOT MVX_PKG_CC)
    message(WARNING
      "mvx: ${name} ${version} would be built from source here, but there is\n"
      "     no C compiler (cc/gcc/clang) on PATH.")
    return()
  endif()

  set(sdir "${workdir}/src")
  file(REMOVE_RECURSE "${sdir}")
  file(MAKE_DIRECTORY "${sdir}")
  get_filename_component(stgz "${srcurl}" NAME)
  message(STATUS "  building ${name} ${version} from source (${stgz})")

  # THE SAME CARE AS THE BINARY.  Both the checksum and the archive, because a
  # source tarball that builds and installs is as much a trust decision as a
  # binary that runs.
  file(DOWNLOAD "${srcurl}.sha256" "${sdir}/sum" STATUS ssumst TIMEOUT 60)
  list(GET ssumst 0 ssumrc)
  file(DOWNLOAD "${srcurl}" "${sdir}/${stgz}" STATUS sdlst TIMEOUT 300)
  list(GET sdlst 0 sdlrc)
  if(NOT sdlrc EQUAL 0)
    list(GET sdlst 1 sdlmsg)
    message(WARNING "mvx: cannot download ${name} ${version} source -- ${sdlmsg}")
    return()
  endif()
  if(ssumrc EQUAL 0)
    file(READ "${sdir}/sum" ssumline)
    string(REGEX MATCH "[0-9a-fA-F]+" swant "${ssumline}")
    file(SHA256 "${sdir}/${stgz}" sgot)
    string(TOLOWER "${swant}" swant)
    if(NOT swant STREQUAL "" AND NOT swant STREQUAL sgot)
      message(FATAL_ERROR
        "mvx: ${name} ${version} source failed its checksum\n"
        "     published ${swant}\n"
        "     downloaded ${sgot}\n"
        "     Refusing to build it.")
    endif()
  endif()

  file(ARCHIVE_EXTRACT INPUT "${sdir}/${stgz}" DESTINATION "${sdir}/x")

  # MVXHOME, not MVX_ROOT: build-native.sh prefers an mvx SOURCE tree's
  # runtime/include + build/lib and falls back to an installed prefix's
  # include + lib.  What is being installed is the prefix, and it already has
  # both by the time packages are fetched -- so point at it and let the
  # fallback branch run.  The extracted tree lives under the build directory,
  # whose parent is not an mvx tree, so the first branch cannot match by
  # accident.
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env
            "MVXBASIC=${CMAKE_INSTALL_PREFIX}/bin/mvx-basic"
            "MVXHOME=${CMAKE_INSTALL_PREFIX}"
            sh "${mkpkg}" "${sdir}/x"
    OUTPUT_VARIABLE bout ERROR_VARIABLE bout RESULT_VARIABLE brc)
  if(NOT brc EQUAL 0)
    # The build output is the only thing that says WHICH header or library is
    # absent, and a truncated tail is what made the binary path's failure
    # unreadable, so keep it.
    message(WARNING
      "mvx: ${name} ${version} did not build here:\n${bout}\n"
      "     The toolchain is installed; ${name} is not.  Install this\n"
      "     package's build dependencies (on Debian/Ubuntu that is\n"
      "     build-essential, pkg-config and the -dev package for each library\n"
      "     it needs), then add it with:\n"
      "         mvx -c \"MVPKG install ${name}\"")
    return()
  endif()
  set(${outvar} "${sdir}/x" PARENT_SCOPE)
endfunction()

# mvx_install_url(<display> <version> <tarball-url> <depth> [<source-url>])
#
# Download, verify, check that its native libraries load, install, and then
# install what IT requires.  With a source URL, a package whose prebuilt
# libraries cannot load here is BUILT here instead of skipped (mvx#370).
function(mvx_install_url name version url depth)
  set(srcurl "")
  if(ARGC GREATER 4)
    set(srcurl "${ARGV4}")
  endif()
  set(tmp "${BIN}/pkgdl/${name}")
  file(REMOVE_RECURSE "${tmp}")
  file(MAKE_DIRECTORY "${tmp}")
  get_filename_component(tgz "${url}" NAME)

  # THE CHECKSUM IS PUBLISHED, SO IT IS CHECKED.  Every asset has a .sha256
  # beside it; downloading one and not the other is choosing to trust the
  # network for no reason.
  file(DOWNLOAD "${url}.sha256" "${tmp}/sum" STATUS sumst TIMEOUT 60)
  list(GET sumst 0 sumrc)
  file(DOWNLOAD "${url}" "${tmp}/${tgz}" STATUS dlst TIMEOUT 300)
  list(GET dlst 0 dlrc)
  if(NOT dlrc EQUAL 0 OR NOT sumrc EQUAL 0)
    list(GET dlst 1 dlmsg)
    # NOT AN ERROR, AND IT SAYS WHY.  These packages publish
    # mvx-linux-x86_64-le only; on macOS -- which is where mvx is developed --
    # there is nothing to fetch, and failing here would make mvx uninstallable
    # on the platform it is written on.  A silent skip would be worse than
    # either: `GIT' would simply not be there, months later, with nothing to
    # read.  So say it, and carry on.
    message(WARNING
      "mvx: no ${name} package for ${MVX_PKG_TRIPLE} -- ${dlmsg}\n"
      "     tried ${url}\n"
      "     The toolchain is installed; ${name} is not.  Install it later with\n"
      "     mvpkg, or set -DMVX_BUNDLED_PACKAGES=\"\" to stop looking.")
    return()
  endif()
  file(READ "${tmp}/sum" sumline)
  string(REGEX MATCH "[0-9a-fA-F]+" want "${sumline}")
  file(SHA256 "${tmp}/${tgz}" got)
  string(TOLOWER "${want}" want)
  if(NOT want STREQUAL "" AND NOT want STREQUAL got)
    message(FATAL_ERROR
      "mvx: ${name} ${version} failed its checksum\n"
      "     published ${want}\n"
      "     downloaded ${got}\n"
      "     Refusing to install it.")
  endif()

  file(ARCHIVE_EXTRACT INPUT "${tmp}/${tgz}" DESTINATION "${tmp}/x")

  # CAN ITS NATIVE LIBRARIES LOAD HERE? (#219)  The git package needs libgit2
  # 1.7, whose soname pins the minor, and installing it on a machine without
  # that library does not merely leave GIT broken: the runtime opens every
  # library in the system account, so EVERY command afterwards prints a loader
  # error.  A package that cannot work here is better not installed -- nothing
  # of it is copied, and mvpkg can add it once the library is there.
  mvx_native_missing("${tmp}/x" "${CMAKE_INSTALL_PREFIX}" missing)
  set(instdir "${tmp}/x")
  if(NOT missing STREQUAL "")
    string(REPLACE ";" "\n            " mtext "${missing}")
    # BUILD IT HERE INSTEAD (mvx#370).  The prebuilt is linked against a
    # library this machine does not have; the source is not, so compile it
    # against what is here rather than leaving the host without the package.
    message(STATUS
      "  ${name} ${version}'s prebuilt libraries need ${mtext}, which is not here")
    mvx_source_build("${name}" "${version}" "${srcurl}" "${tmp}" built)
    if(NOT built STREQUAL "")
      # AND THE BUILD HAS TO ANSWER THE SAME QUESTION.  A build can succeed and
      # still produce something unloadable -- a library resolved at link time
      # from a path the loader does not search is the ordinary way -- so ask
      # again rather than assuming the compiler settled it.
      mvx_native_missing("${built}" "${CMAKE_INSTALL_PREFIX}" bmissing)
      if(bmissing STREQUAL "")
        set(instdir "${built}")
        set(missing "")
      else()
        string(REPLACE ";" "\n            " bmtext "${bmissing}")
        message(WARNING
          "mvx: ${name} ${version} was built here and still cannot load:\n"
          "            ${bmtext}")
      endif()
    endif()
  endif()
  if(NOT missing STREQUAL "")
    message(WARNING
      "mvx: ${name} ${version} needs a library this machine does not have:\n"
      "            ${mtext}\n"
      "     Skipping it -- the toolchain is installed and every other command\n"
      "     stays clean.  Install the library (on Debian/Ubuntu, apt-get\n"
      "     install the package that provides it), then add ${name} with:\n"
      "         mvx -c \"MVPKG install ${name}\"")
    file(REMOVE_RECURSE "${tmp}")
    return()
  endif()

  mvx_install_tree("${name}" "${instdir}")
  message(STATUS "  installed package ${name} ${version} (${MVX_PKG_TRIPLE})")
  _mvx_mark_installed("${name}")

  # WHAT IT NEEDS COMES WITH IT.  mvpkg declares `curl', and without it an
  # installed mvpkg cannot reach the HTTPS registry at all (#218).
  if(EXISTS "${instdir}/mvpkg.json")
    math(EXPR next "${depth} + 1")
    mvx_install_deps("${instdir}/mvpkg.json" ${next})
  endif()
  file(REMOVE_RECURSE "${tmp}")
endfunction()

# mvx_fetch_package(<display> <repo> <asset-stem> <version>)
#
# A bundled package, whose asset name and location are known without asking the
# registry.  The asset is account-shaped with its contents at the tar root --
# CATALOG, VOC, LIB, and for git a bin/ -- so it unpacks straight into the
# system account.
function(mvx_fetch_package name repo stem version)
  set(tgz "${stem}-${version}-mvx-${MVX_PKG_TRIPLE}.tar.gz")
  set(url "${MVX_PKG_BASEURL}/${repo}/releases/download/${version}/${tgz}")
  # THE SOURCE ASSET OF THE SAME RELEASE, for building here when the prebuilt
  # cannot load (mvx#370).  Taken from the release listing `mvx_choose_version'
  # already fetched -- the asset names are not predictable from the stem, and
  # the listing is where both the names and the URLs are.
  #
  # A version set at configure time deliberately skips that listing, so there
  # is nothing to read and the fallback is simply unavailable: the install then
  # behaves as it did before this existed.
  if(DEFINED ENV{MVX_INSTALL_RELEASES})
    set(rjson "$ENV{MVX_INSTALL_RELEASES}/${repo}.json")
  else()
    set(rjson "${BIN}/pkgdl/${repo}.releases.json")
  endif()
  mvx_source_asset("${rjson}" "${version}" srcurl)
  mvx_install_url("${name}" "${version}" "${url}" 0 "${srcurl}")
endfunction()

# WHICH VERSION is asked, not pinned (mvx#212): pkgver.cmake lists each
# package's releases and takes the answer -- or, with nobody at the terminal,
# the latest stable.  A version set at configure time is used as given.
include("${CMAKE_CURRENT_LIST_DIR}/pkgver.cmake")

# mvx_install_package(<display> <repo> <asset-stem> <override>)
function(mvx_install_package name repo stem override)
  mvx_choose_version("${name}" "${repo}" "${stem}" "${MVX_PKG_TRIPLE}"
                     "${override}" "${BIN}/pkgdl" version)
  if(NOT version STREQUAL "")
    mvx_fetch_package("${name}" "${repo}" "${stem}" "${version}")
  endif()
endfunction()

mvx_install_package(mvpkg mv_package mvpkg "@MVX_PACKAGE_VERSION_mvpkg@")
foreach(pkg @MVX_BUNDLED_PACKAGES@)
  if("${pkg}" STREQUAL "git")
    mvx_install_package(git mv_git mv_git "@MVX_PACKAGE_VERSION_git@")
  else()
    message(WARNING "mvx: no published asset is known for package '${pkg}'")
  endif()
endforeach()

message(STATUS "MVX system account installed to ${SYS}")

cmake_policy(POP)
